# Copy to .env for local development. Keep real values private.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_URL=http://127.0.0.1:3000/public
APP_BASE_URL=http://127.0.0.1:3000/public
ALLOWED_ORIGINS=http://127.0.0.1:4173

# Production requires a random secret of at least 32 characters.
JWT_SECRET=
SESSION_TTL=12h

# Optional email and lead notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Production uploads use S3 and the AWS SDK credential provider chain.
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=
MAX_UPLOAD_BYTES=10485760
LEAD_RATE_LIMIT_MS=10000

# Optional paths on a persistent local disk. Defaults are under backend/data.
USERS_FILE=
LEADS_FILE=
FILES_FILE=
RESET_TOKENS_FILE=
AUDIT_FILE=
UPLOAD_DIR=
